function renderWebPanel(r){
  if(!r||r.status!==200){$('webInfo').textContent='falha: '+(r?('HTTP '+r.status):'sem resposta');return;}
  $('webInfo').textContent='HTTP '+r.status+' · '+String(r.contentType||'').split(';')[0];
  // extrai <body> e injeta de forma isolada (sem scripts da impressora)
  var body=r.body||'';
  var m=body.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
  var inner=m?m[1]:body;
  inner=inner.replace(/<script[\s\S]*?<\/script>/gi,'').replace(/\son\w+="[^"]*"/gi,'');
  $('webFrame').srcdoc='<base href="http://'+esc($('webIp').textContent)+'/">'+inner;
}

