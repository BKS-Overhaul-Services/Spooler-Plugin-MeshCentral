function doSetDefault(n){send('setDefaultPrinter',{name:n});}
function sendCfg(n,which){
  if(which.pausePrinter){setBusy('pausePrinter',true);send('pausePrinter',{name:n});}
  else if(which.resumePrinter){setBusy('resumePrinter',true);send('resumePrinter',{name:n});}
}

