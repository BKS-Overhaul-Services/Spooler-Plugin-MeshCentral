var _discMode='wsd';
function showDiscoverDlg(){switchTab('discover');}
function discModeChanged(){
  _discMode=$('discMode').value;
  var isTcp=(_discMode==='tcp');
  $('discRange').style.display=isTcp?'':'none';
  $('discTimeout').style.display=isTcp?'':'none';
  var hints={wsd:'WSD: multicast local (~5s). Impressoras precisam estar ligadas e na mesma VLAN.',
    ad:'AD: lista impressoras publicadas no domínio (print servers). Não precisa varredura.',
    tcp:'TCP: varre a sub-rede na porta 9100 (RAW). Mais lento; último recurso.'};
  $('discHint').textContent=hints[_discMode]||'';
}
function startDiscover(){
  var mode=_discMode;
  var msg={wsd:'Procurando impressoras via WSD (até ~12s)...',ad:'Consultando Active Directory...',tcp:'Varrendo sub-rede porta 9100 (até ~10s)...'};
  $('discResult').innerHTML='<div class="loading">'+(msg[mode]||'Procurando...')+'</div>';
  $('discInfo').textContent='';
  $('installSelBtn').disabled=true;
  _selected={};
  setBusy('discover',true);
  send('discover',{mode:mode,range:$('discRange').value.trim(),timeout:parseInt($('discTimeout').value,10)});
}
function renderFound(list,mode){
  _found=list||[];
  var errs=_found.filter(function(f){return f.error;});
  if(errs.length){$('discResult').innerHTML='<div class="empty">Erro: '+esc(errs[0].error)+'</div>';return;}
  if(!_found.length){
    var empty={wsd:'Nenhuma impressora respondeu ao WSD. Verifique se estão ligadas, na mesma VLAN (multicast 239.255.255.250:3702 liberado) e com WSD habilitado. Alternativa: tente "Active Directory" ou "TCP 9100".',
      ad:'Nenhuma printQueue no Active Directory (nenhum print server publicou impressoras no domínio). Tente "WSD" ou "TCP 9100".',
      tcp:'Nenhum host com porta 9100 aberta na sub-rede.'};
    $('discResult').innerHTML='<div class="empty">'+esc(empty[mode]||'Nada encontrado.')+'</div>';return;}
  $('discInfo').textContent=_found.length+' encontrada(s)';
  if(mode==='ad'){
    var h='<table class="tbl"><thead><tr><th></th><th>Impressora</th><th>Servidor</th><th>Local</th><th>Driver</th></tr></thead><tbody>';
    _found.forEach(function(f){
      var key=f.unc||(f.host+'\\'+f.name);
      h+='<tr><td><input type="checkbox" onchange="toggleSel(\''+esc(key)+'\')"></td>'
        +'<td><b>'+esc(f.name||'—')+'</b></td><td>'+esc(f.host||'—')+'</td>'
        +'<td>'+esc(f.location||'—')+'</td><td class="muted">'+esc(f.driver||'—')+'</td></tr>';
    });
    h+='</tbody></table>';$('discResult').innerHTML=h;return;
  }
  if(mode==='wsd'){
    var h2='';
    _found.forEach(function(f,idx){
      var key=String(idx);
      h2+='<div class="foundcard">'
        +'<input type="checkbox" onchange="toggleSel(\''+esc(key)+'\')">'
        +'<div class="ip">'+esc(f.ip)+'</div>'
        +'<div style="flex:1"><div class="muted">'+esc((f.xaddrs||'—').substring(0,90))+'</div></div>'
        +'</div>';
    });
    $('discResult').innerHTML='<p class="muted" style="margin-bottom:6px">WSD descobre o dispositivo; para instalar, use o IP (XAddrs) com a aba "Adicionar impressora".</p>'+h2;
    return;
  }
  var h3='';
  _found.forEach(function(f){
    var key=f.ip;
    var model=bestPrinterName(f);
    var srcBadge={ipp:'IPP','ipp-name':'IPP',pjl:'PJL',http:'HTTP'}[f.modelSource]||'';
    var det=[];
    if(f.printerName&&!(/^(ipp|ipps|print|ipp\/print)$/i).test(f.printerName))det.push('fila: '+f.printerName);
    if(f.firmware)det.push('firmware: '+f.firmware);
    if(f.hostname)det.push(f.hostname);
    h3+='<div class="foundcard">'
      +'<input type="checkbox" onchange="toggleSel(\''+esc(key)+'\')" data-ip="'+esc(key)+'">'
      +'<div class="ip">'+esc(f.ip)+'</div>'
      +'<div style="flex:1"><div><b>'+esc(model)+'</b>'+(srcBadge?(' <span class="badge">'+esc(srcBadge)+'</span>'):'')+'</div>'
      +(det.length?'<div class="muted">'+esc(det.join(' · '))+'</div>':'')
      +'</div>'
      +'<button class="btn btn-sm btn-primary" onclick="showInstall(\''+esc(key)+'\')">Instalar</button>'
      +'</div>';
  });
  $('discResult').innerHTML=h3;
}
function toggleSel(ip){
  if(_selected[ip])delete _selected[ip];else _selected[ip]=true;
  var n=Object.keys(_selected).length;
  $('installSelBtn').disabled=(n===0);
  $('installSelBtn').textContent='Instalar selecionadas ('+n+')';
}
function bestPrinterName(f){
  // precedência validada: model > printerName (se não for path de fila) > hostname > IP
  var useless=/^(ipp|ipps|print|ipp\/print)$/i;
  if(f.model)return f.model;
  if(f.printerName&&!useless.test(f.printerName))return f.printerName;
  if(f.hostname)return f.hostname.split('.')[0];
  return 'Impressora_'+f.ip.replace(/\./g,'-');
}
function showInstall(ip){
  var f=_found.find(function(x){return x.ip===ip;})||{};
  $('instIp').value=ip;
  $('instHost').value=f.hostname||'—';
  $('instName').value=bestPrinterName(f);
  if(!_drivers.length)send('listDrivers');
  $('dlgInstall').showModal();
}
function doInstallFound(){
  var ip=$('instIp').value,name=$('instName').value.trim(),driver=$('instDriver').value,port=parseInt($('instPort').value,10)||9100;
  if(!name||!driver){toast('Preencha nome e driver',true);return;}
  dlgBusy('dlgInstall','instBtn','instStatus',true,'Instalando "'+esc(name)+'" (o Windows prepara o driver — pode levar até 60s)...');
  send('addFoundPrinter',{ip:ip,name:name,driver:driver,port:port});
}
var _batch={total:0,done:0,ok:0,fail:0};
function installSelected(){
  var ips=Object.keys(_selected);
  if(!ips.length)return;
  if(!_drivers.length){toast('Carregue os drivers primeiro (aba Portas & Drivers)',true);return;}
  var driver=prompt('Driver para TODAS as selecionadas (ex: HP Universal Printing PCL 6):','');
  if(!driver)return;
  var port=parseInt(prompt('Porta TCP (padrão 9100):','9100'),10)||9100;
  _batch={total:ips.length,done:0,ok:0,fail:0};
  $('discInfo').textContent='Instalando 0/'+ips.length+'...';
  ips.forEach(function(ip,idx){
    setTimeout(function(){
      var f=_found.find(function(x){return x.ip===ip;})||{};
      var name=bestPrinterName(f);
      send('addFoundPrinter',{ip:ip,name:name,driver:driver,port:port,_batch:true});
    },idx*2000);
  });
}

