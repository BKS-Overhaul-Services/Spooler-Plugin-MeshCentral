<html>
<head>
<meta charset="utf-8">
<title>{{nodeName}} — Impressoras</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Trebuchet MS",Arial,Helvetica,sans-serif;background:#d3d9d6;color:#000;padding:12px;font-size:13px;line-height:1.35}
.header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.header h1{font-size:18px;font-weight:700;color:#003366}
.header .sub{color:#444;font-size:12px;margin-top:2px}
.stats{display:flex;gap:6px;flex-wrap:wrap}
.stat{background:#fff;border:1px solid #aaa;border-radius:3px;padding:8px 12px;min-width:88px}
.stat .n{font-size:18px;font-weight:700;color:#003366}
.stat .l{font-size:10px;color:#666;text-transform:uppercase;margin-top:1px}
.panel{background:#fff;border:1px solid #aaa;border-radius:3px;padding:10px;margin-bottom:10px}
.panel-title{background:#c0c0c0;color:#000;font-size:12px;font-weight:700;padding:5px 8px;margin:-10px -10px 10px -10px;border-bottom:1px solid #aaa}
.toolbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:8px}
.btn{font-family:inherit;font-size:12px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:5px 12px;border-radius:2px;cursor:pointer}
.btn:hover{background:#e4e4e4}
.btn-primary{background:#003366;color:#fff;border-color:#002244}
.btn-primary:hover{background:#004080}
.btn-danger{background:#c62828;color:#fff;border-color:#8e1b1b}
.btn-danger:hover{background:#a02222}
.btn-sm{font-size:11px;padding:3px 8px}
.btn:disabled{opacity:.5;cursor:not-allowed}
select,input[type=text],input[type=number],input[type=checkbox]{font-family:inherit;font-size:12px;border:1px solid #808080;background:#fff;color:#000;padding:4px 6px;border-radius:2px}
.tabs{display:flex;gap:0;margin-bottom:8px;border-bottom:2px solid #003366}
.tabs button{border:1px solid #808080;border-bottom:none;background:#606060;color:#fff;padding:6px 14px;cursor:pointer;font-family:inherit;font-size:12px;margin-right:2px;border-radius:4px 4px 0 0}
.tabs button.active{background:#003366;border-color:#003366;font-weight:700}
.pane{display:none}.pane.active{display:block}
table.tbl{width:100%;border-collapse:collapse;font-size:12px}
table.tbl th{background:#aaa;color:#000;font-weight:700;text-align:left;padding:5px 7px;border:1px solid #999}
table.tbl td{padding:5px 7px;border-bottom:1px solid #ddd;vertical-align:middle}
table.tbl tr:nth-child(even) td{background:#f4f6f5}
table.tbl tr:hover td{background:#e8f0f8}
.badge{display:inline-block;font-size:10px;padding:1px 6px;border-radius:999px;background:#ddd;color:#333;font-weight:700}
.badge.ok{background:#c8e6c9;color:#1b5e20}
.badge.warn{background:#fff3cd;color:#7a5c00}
.badge.err{background:#ffcdd2;color:#8e1b1b}
.muted{color:#666;font-size:11px}
.empty,.loading{text-align:center;padding:24px;color:#666}
.field{display:flex;flex-direction:column;gap:3px;margin-bottom:8px}
.field label{font-size:11px;font-weight:700;color:#444}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
@media(max-width:900px){.grid2,.grid3{grid-template-columns:1fr}}
.foundcard{display:flex;gap:10px;align-items:center;background:#f7f8f7;border:1px solid #bbb;border-radius:2px;padding:8px 10px;margin-bottom:6px}
.foundcard:hover{border-color:#003366;background:#eef3f8}
.foundcard .ip{font-weight:700;color:#003366;font-size:13px;min-width:130px}
dialog{border:1px solid #808080;border-radius:4px;padding:0;max-width:640px;width:92%;box-shadow:0 4px 24px rgba(0,0,0,.4)}
dialog::backdrop{background:rgba(0,0,0,.5)}
.dlg-head{background:#003366;color:#fff;padding:8px 12px;font-weight:700;font-size:13px;display:flex;justify-content:space-between;align-items:center}
.dlg-body{padding:12px;max-height:70vh;overflow:auto}
.dlg-foot{padding:10px 12px;border-top:1px solid #ccc;display:flex;gap:8px;justify-content:flex-end;background:#f4f6f5}
#webFrame{width:100%;height:480px;border:1px solid #ccc;background:#fff}
#dbgToggle{cursor:pointer;font-size:11px;color:#003366;user-select:none;margin-top:10px;text-decoration:underline}
#debug{display:none;background:#fff8e1;border:1px solid #e0c060;color:#333;padding:6px;margin-top:4px;font-size:10px;font-family:Consolas,monospace;max-height:140px;overflow:auto;border-radius:2px;white-space:pre-wrap}
.toast{position:fixed;bottom:14px;right:14px;background:#003366;color:#fff;padding:10px 16px;border-radius:4px;font-size:12px;box-shadow:0 2px 12px rgba(0,0,0,.4);z-index:99;display:none;max-width:420px}
.toast.err{background:#c62828}
</style>
</head>
<body>
<div class="header">
  <div>
    <h1>Impressoras — {{nodeName}}</h1>
    <div class="sub">CRUD · descoberta de rede · filas · spooler · painel web</div>
  </div>
  <div class="stats">
    <div class="stat"><div class="n" id="sPrinters">—</div><div class="l">Impressoras</div></div>
    <div class="stat"><div class="n" id="sJobs">—</div><div class="l">Jobs na fila</div></div>
    <div class="stat"><div class="n" id="sSpooler">—</div><div class="l">Spooler</div></div>
  </div>
</div>

<div class="tabs">
  <button class="active" id="tPrinters" onclick="switchTab('printers')">Impressoras</button>
  <button id="tDiscover" onclick="switchTab('discover')">Descoberta</button>
  <button id="tJobs" onclick="switchTab('jobs')">Filas</button>
  <button id="tPorts" onclick="switchTab('ports')">Portas & Drivers</button>
  <button id="tSpooler" onclick="switchTab('spooler')">Serviço Spooler</button>
  <button id="tAudit" onclick="switchTab('audit')">Auditoria</button>
</div>

<!-- ===== IMPRESSORAS ===== -->
<div id="pane-printers" class="pane active">
  <div class="panel">
    <div class="panel-title">Impressoras instaladas</div>
    <div class="toolbar">
      <button class="btn btn-primary" onclick="refreshInventory()">Atualizar inventário</button>
      <button class="btn" onclick="showAddDlg()">Adicionar impressora</button>
      <button class="btn" onclick="showDiscoverDlg()">Procurar na rede</button>
      <span class="muted" id="invInfo"></span>
    </div>
    <div id="printerList"><div class="empty">Clique em "Atualizar inventário".</div></div>
  </div>
</div>

<!-- ===== DESCOBERTA ===== -->
<div id="pane-discover" class="pane">
  <div class="panel">
    <div class="panel-title">Procurar impressoras</div>
    <div class="toolbar">
      <select id="discMode" style="min-width:250px" onchange="discModeChanged()">
        <option value="wsd">WSD — nativo (como o wizard do Windows)</option>
        <option value="ad">Active Directory — impressoras do domínio</option>
        <option value="tcp">Varredura TCP 9100 (último recurso)</option>
      </select>
      <input type="text" id="discRange" placeholder="range p/ TCP: 192.168.0" style="width:200px;display:none">
      <select id="discTimeout" style="display:none"><option value="1000">Timeout 1s</option><option value="2000">2s</option><option value="500">0.5s</option></select>
      <button class="btn btn-primary" id="discBtn" onclick="startDiscover()">Procurar</button>
      <button class="btn btn-primary" id="installSelBtn" onclick="installSelected()" disabled>Instalar selecionadas (0)</button>
      <span class="muted" id="discInfo"></span>
    </div>
    <p class="muted" id="discHint" style="margin-bottom:8px">WSD: multicast local (~5s). Impressoras precisam estar ligadas e na mesma VLAN.</p>
    <div id="discResult"><div class="empty">Nenhuma busca executada.</div></div>
  </div>
</div>

<!-- ===== FILAS ===== -->
<div id="pane-jobs" class="pane">
  <div class="panel">
    <div class="panel-title">Fila de impressão</div>
    <div class="toolbar">
      <select id="jobsPrinter" style="min-width:220px"><option value="">— Todas as impressoras —</option></select>
      <button class="btn btn-primary" onclick="loadJobs()">Ver jobs</button>
      <button class="btn btn-danger" onclick="clearQueue()">Limpar fila da impressora</button>
      <span class="muted" id="jobsInfo"></span>
    </div>
    <div id="jobList"><div class="empty">Selecione e clique em "Ver jobs".</div></div>
  </div>
</div>

<!-- ===== PORTAS & DRIVERS ===== -->
<div id="pane-ports" class="pane">
  <div class="grid2">
    <div class="panel">
      <div class="panel-title">Portas de impressora</div>
      <div class="toolbar"><button class="btn btn-primary" onclick="loadPorts()">Listar portas</button></div>
      <div id="portList"><div class="empty">—</div></div>
    </div>
    <div class="panel">
      <div class="panel-title">Drivers instalados</div>
      <div class="toolbar"><button class="btn btn-primary" onclick="loadDrivers()">Listar drivers</button></div>
      <div id="driverList"><div class="empty">—</div></div>
    </div>
  </div>
</div>

<!-- ===== SPOOLER ===== -->
<div id="pane-spooler" class="pane">
  <div class="panel">
    <div class="panel-title">Serviço Print Spooler (Windows)</div>
    <div class="toolbar">
      <button class="btn" onclick="loadSpoolerStatus()">Ver status</button>
      <button class="btn" onclick="spoolerAction('start')">Iniciar</button>
      <button class="btn" onclick="spoolerAction('stop')">Parar</button>
      <button class="btn btn-primary" onclick="spoolerAction('restart')">Reiniciar</button>
      <button class="btn btn-sm" onclick="loadPsInfo()">Diagnóstico PS</button>
      <button class="btn btn-sm" id="dbgBtn" onclick="toggleAgentDebug()">Debug agente: OFF</button>
      <span class="muted" id="spoolerInfo"></span>
    </div>
    <div id="spoolerStatus"><div class="empty">—</div></div>
    <div id="psInfo" style="display:none"></div>
  </div>
</div>

<!-- ===== AUDITORIA ===== -->
<div id="pane-audit" class="pane">
  <div class="panel">
    <div class="panel-title">Auditoria de operações</div>
    <div class="toolbar"><button class="btn btn-primary" onclick="loadAudit()">Atualizar</button></div>
    <div id="auditList"><div class="empty">—</div></div>
  </div>
</div>

<div id="dbgToggle" onclick="var e=document.getElementById('debug');e.style.display=e.style.display==='none'?'block':'none'">Debug</div>
<div id="debug">aguardando...</div>
<div class="toast" id="toast"></div>

<!-- DIALOG: adicionar impressora -->
<dialog id="dlgAdd">
  <div class="dlg-head"><span>Adicionar impressora</span><button class="btn btn-sm" onclick="closeDlg('dlgAdd')">✕</button></div>
  <div class="dlg-body">
    <div class="field"><label>Nome da impressora *</label><input type="text" id="addName" placeholder="Ex: HP-Lab-2oAndar"></div>
    <div class="field"><label>IP / Host *</label><input type="text" id="addIp" placeholder="Ex: 192.168.0.50"></div>
    <div class="grid2">
      <div class="field"><label>Porta</label><input type="number" id="addPort" value="9100"></div>
      <div class="field"><label>Driver *</label><select id="addDriver"><option value="">— carregando —</option></select></div>
    </div>
    <div class="grid2">
      <div class="field"><label>Compartilhar</label><input type="checkbox" id="addShared"> <span class="muted">compartilhada na rede</span></div>
      <div class="field"><label>Definir como padrão</label><input type="checkbox" id="addDefault"></div>
    </div>
  </div>
  <div class="dlg-foot">
    <button class="btn" onclick="closeDlg('dlgAdd')">Cancelar</button>
    <button class="btn btn-primary" id="addBtn" onclick="doAddPrinter()">Adicionar</button>
  </div>
  <div class="dlg-status muted" id="addStatus" style="padding:0 12px 10px"></div>
</dialog>

<!-- DIALOG: instalar impressora encontrada -->
<dialog id="dlgInstall">
  <div class="dlg-head"><span>Instalar impressora encontrada</span><button class="btn btn-sm" onclick="closeDlg('dlgInstall')">✕</button></div>
  <div class="dlg-body">
    <div class="field"><label>IP</label><input type="text" id="instIp" readonly></div>
    <div class="field"><label>Hostname</label><input type="text" id="instHost" readonly></div>
    <div class="field"><label>Nome da impressora *</label><input type="text" id="instName"></div>
    <div class="field"><label>Driver *</label><select id="instDriver"><option value="">— carregando —</option></select></div>
    <div class="field"><label>Porta</label><input type="number" id="instPort" value="9100"></div>
  </div>
  <div class="dlg-foot">
    <button class="btn" onclick="closeDlg('dlgInstall')">Cancelar</button>
    <button class="btn btn-primary" id="instBtn" onclick="doInstallFound()">Instalar</button>
  </div>
  <div class="dlg-status muted" id="instStatus" style="padding:0 12px 10px"></div>
</dialog>

<!-- DIALOG: configurar impressora -->
<dialog id="dlgConfig">
  <div class="dlg-head"><span>Configurar: <span id="cfgName"></span></span><button class="btn btn-sm" onclick="closeDlg('dlgConfig')">✕</button></div>
  <div class="dlg-body">
    <div class="grid2">
      <div class="field"><label>Compartilhada</label><input type="checkbox" id="cfgShared"></div>
      <div class="field"><label>Nome de compartilhamento</label><input type="text" id="cfgShareName"></div>
      <div class="field"><label>Prioridade (1-99)</label><input type="number" id="cfgPriority" min="1" max="99"></div>
      <div class="field"><label>Trabalhar offline</label><input type="checkbox" id="cfgOffline"></div>
      <div class="field"><label>Driver</label><select id="cfgDriver"><option value="">— manter —</option></select></div>
      <div class="field"><label>Porta</label><select id="cfgPort"><option value="">— manter —</option></select></div>
    </div>
  </div>
  <div class="dlg-foot">
    <button class="btn" onclick="closeDlg('dlgConfig')">Cancelar</button>
    <button class="btn btn-primary" onclick="doSaveConfig()">Salvar</button>
  </div>
</dialog>

<!-- DIALOG: renomear -->
<dialog id="dlgRename">
  <div class="dlg-head"><span>Renomear impressora</span><button class="btn btn-sm" onclick="closeDlg('dlgRename')">✕</button></div>
  <div class="dlg-body">
    <div class="field"><label>Nome atual</label><input type="text" id="renOld" readonly></div>
    <div class="field"><label>Novo nome *</label><input type="text" id="renNew"></div>
  </div>
  <div class="dlg-foot">
    <button class="btn" onclick="closeDlg('dlgRename')">Cancelar</button>
    <button class="btn btn-primary" onclick="doRename()">Renomear</button>
  </div>
</dialog>

<!-- DIALOG: painel web -->
<dialog id="dlgWeb" style="max-width:960px">
  <div class="dlg-head"><span>Painel web — <span id="webIp"></span></span><button class="btn btn-sm" onclick="closeDlg('dlgWeb')">✕</button></div>
  <div class="dlg-body">
    <div class="toolbar"><button class="btn btn-primary btn-sm" onclick="loadWebPanel()">Recarregar</button><span class="muted" id="webInfo"></span></div>
    <iframe id="webFrame" sandbox="allow-same-origin"></iframe>
  </div>
</dialog>
<!-- DIALOG: excluir confirmação -->
<dialog id="dlgDel">
  <div class="dlg-head" style="background:#c62828"><span>Confirmar exclusão</span><button class="btn btn-sm" onclick="closeDlg('dlgDel')">✕</button></div>
  <div class="dlg-body">
    <p>Excluir a impressora <b id="delName"></b>?</p>
    <p class="muted"><input type="checkbox" id="delPort"> Excluir também a porta TCP/IP (se não estiver em uso)</p>
  </div>
  <div class="dlg-foot">
    <button class="btn" onclick="closeDlg('dlgDel')">Cancelar</button>
    <button class="btn btn-danger" onclick="doDelete()">Excluir</button>
  </div>
</dialog>

<script>
var nodeid='{{nodeid}}', nodeName='{{nodeName}}';
var ms=(typeof parent!=='undefined'&&parent.meshserver)||window.meshserver;
var D=[];
var _printers=[], _drivers=[], _ports=[], _jobs=[], _found=[], _selected={}, _spooler=null;
var _ops={}; // op → true enquanto pendente

function dlog(){var a=Array.prototype.slice.call(arguments);D.push(new Date().toLocaleTimeString()+' '+a.join(' '));var e=document.getElementById('debug');if(e)e.innerHTML=D.slice(-80).join('\n');}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function $(id){return document.getElementById(id);}
function toast(msg,err){var t=$('toast');t.textContent=msg;t.className='toast'+(err?' err':'');t.style.display='block';clearTimeout(t._h);t._h=setTimeout(function(){t.style.display='none';},5000);}
function closeDlg(id){var d=$(id);if(d.open)d.close();}
function setBusy(op,b){_ops[op]=b;document.querySelectorAll('button').forEach(function(x){if(x.dataset.op===op)x.disabled=b;});}

/* ===== WS ===== */
if(ms&&ms.socket){
  var orig=ms.socket.onmessage;
  ms.socket.onmessage=function(event){
    try{
      var d=JSON.parse(event.data);
      if(d.action==='plugin'&&d.plugin==='spooler'&&d.method==='agentResult'){
        dlog('WS result', d.op, 'ok='+(d.ok===true));
        handleResult(d);
        return;
      }
    }catch(e){}
    if(typeof orig==='function')orig.call(ms.socket,event);
  };
  dlog('socket hooked');
} else dlog('ms/socket não disponível');

function send(action,params){ if(ms){ ms.send({action:'plugin',plugin:'spooler',pluginaction:action,nodeid:nodeid,params:params||{}}); } else toast('Sem conexão',true); }

function handleResult(d){
  var op=d.op;
  setBusy(op,false);
  if(!d.ok){
    toast(op+': '+(d.error||'erro'),true);
    // destrava dialogs de instalação e mostra o erro dentro deles (dá pra tentar de novo)
    if(op==='addPrinter')dlgBusy('dlgAdd','addBtn','addStatus',false,'Erro: '+(d.error||'falha desconhecida'));
    if(op==='addFoundPrinter')dlgBusy('dlgInstall','instBtn','instStatus',false,'Erro: '+(d.error||'falha desconhecida'));
    if(op==='inventory'){$('invInfo').textContent='erro: '+d.error;}
    return;
  }
  var r=d.result;
  switch(op){
    case 'inventory': renderPrinters(r||[]); break;
    case 'listDrivers': _drivers=r||[]; fillDriverSelects(); renderDrivers(); break;
    case 'listPorts': _ports=r||[]; fillPortSelects(); renderPorts(); break;
    case 'addPrinter':
      dlgBusy('dlgAdd','addBtn','addStatus',false,'');
      closeDlg('dlgAdd');
      toast('Impressora "'+(r&&r.name?r.name:'')+'" instalada com sucesso');
      refreshInventory(); loadPorts();
      break;
    case 'addFoundPrinter':
      if(d._batch){
        _batch.done++; if(d.ok)_batch.ok++; else _batch.fail++;
        $('discInfo').textContent='Instalando '+_batch.done+'/'+_batch.total+' (ok: '+_batch.ok+', falha: '+_batch.fail+')...';
        if(_batch.done>=_batch.total){
          $('discInfo').textContent='Lote concluído: '+_batch.ok+' instalada(s), '+_batch.fail+' falha(s)';
          toast('Lote concluído: '+_batch.ok+' instalada(s), '+_batch.fail+' falha(s)', _batch.fail>0);
        }
      } else {
        dlgBusy('dlgInstall','instBtn','instStatus',false,'');
        closeDlg('dlgInstall');
        toast('Impressora "'+(r&&r.name?r.name:'')+'" instalada com sucesso');
        _selected={}; $('installSelBtn').disabled=true; $('installSelBtn').textContent='Instalar selecionadas (0)';
      }
      refreshInventory();
      break;
    case 'deletePrinter': toast('Impressora excluída'); closeDlg('dlgDel'); refreshInventory(); break;
    case 'renamePrinter': toast('Impressora renomeada'); closeDlg('dlgRename'); refreshInventory(); break;
    case 'setDefaultPrinter': toast('Padrão definido'); refreshInventory(); break;
    case 'setPrinterConfig': toast('Configuração salva'); closeDlg('dlgConfig'); refreshInventory(); break;
    case 'pausePrinter': case 'resumePrinter': toast('Operação aplicada'); refreshInventory(); break;
    case 'testPage': toast('Página de teste enviada'); break;
    case 'deletePort': toast('Porta excluída'); loadPorts(); break;
    case 'discover': renderFound(r||[], d.mode||_discMode); break;
    case 'getJobs': renderJobs(r||[]); break;
    case 'jobAction': toast('Job atualizado'); loadJobs(); break;
    case 'clearQueue': toast('Fila limpa'); loadJobs(); break;
    case 'spoolerStatus': _spooler=r; renderSpooler(); break;
    case 'spoolerAction': toast('Spooler: '+(r&&r.status?r.status:'ok')); loadSpoolerStatus(); break;
    case 'webPanel': renderWebPanel(r); break;
    case 'psInfo': renderPsInfo(r); break;
  }
}

/* ===== TABS ===== */
var _tabLoaded={}; // auto-load só na 1ª ativação de cada aba (v1.1.13 anti-spam)
function switchTab(n){
  ['printers','discover','jobs','ports','spooler','audit'].forEach(function(t){
    $('t'+t.charAt(0).toUpperCase()+t.slice(1)).classList.toggle('active',t===n);
    $('pane-'+t).classList.toggle('active',t===n);
  });
  if(n==='audit'&&!_tabLoaded.audit){_tabLoaded.audit=true;loadAudit();}
  if(n==='ports'){ if(!_drivers.length)loadDrivers(); if(!_ports.length)loadPorts(); }
  if(n==='spooler'&&!_tabLoaded.spooler){_tabLoaded.spooler=true;loadSpoolerStatus();}
}

/* ===== INVENTÁRIO ===== */
var _invDeb=null;
function refreshInventory(){
  // debounce 300ms: mutações em sequência (addPrinter→loadPorts→refresh) geram 1 só fetch
  if(_invDeb){clearTimeout(_invDeb);_invDeb=null;}
  if(_ops.inventory){dlog('refreshInventory: já em voo, será refetchado no debounce');}
  _invDeb=setTimeout(function(){_invDeb=null;_doRefreshInventory();},300);
}
function _doRefreshInventory(){
  if(_ops.inventory){dlog('skip dup inventory');return;}
  $('printerList').innerHTML='<div class="loading">Carregando inventário do dispositivo...</div>';
  setBusy('inventory',true);
  send('inventory');
}
function renderPrinters(list){
  _printers=list;
  $('sPrinters').textContent=list.length;
  $('invInfo').textContent=list.length+' impressoras · atualizado '+new Date().toLocaleTimeString();
  if(!list.length){$('printerList').innerHTML='<div class="empty">Nenhuma impressora instalada.</div>';return;}
  var h='<table class="tbl"><thead><tr><th>Nome</th><th>Driver</th><th>Porta</th><th>Status</th><th>Flags</th><th style="width:340px">Ações</th></tr></thead><tbody>';
  list.forEach(function(p){
    var flags=[];
    if(p.default)flags.push('<span class="badge ok">PADRÃO</span>');
    if(p.shared)flags.push('<span class="badge">compartilhada</span>');
    if(p.workOffline)flags.push('<span class="badge warn">offline</span>');
    var st=parseInt(p.printerStatus,10);
    var stTxt=(st===0?'desconhecido':st===3?'ociosa':st===4?'imprimindo':st===5?'aquecendo':st===6?'parada':st===7?'offline':('st '+st));
    var stCls=(st===3||st===4)?'ok':(st===7?'err':'warn');
    var ip=(p.portInfo&&p.portInfo.printerHostAddress)?p.portInfo.printerHostAddress:null;
    h+='<tr>'
      +'<td><b>'+esc(p.name)+'</b></td>'
      +'<td class="muted">'+esc(p.driver)+'</td>'
      +'<td class="muted">'+esc(p.port)+(ip?(' <span class="muted">('+esc(ip)+')</span>'):'')+'</td>'
      +'<td><span class="badge '+stCls+'">'+esc(stTxt)+'</span></td>'
      +'<td>'+(flags.join(' ')||'—')+'</td>'
      +'<td>'
      +'<button class="btn btn-sm" onclick="doTestPage(\''+esc(p.name)+'\')">Teste</button> '
      +(p.default?'':'<button class="btn btn-sm" onclick="doSetDefault(\''+esc(p.name)+'\')">Padrão</button> ')
      +(p.workOffline?'':'<button class="btn btn-sm" onclick="sendCfg(\''+esc(p.name)+'\',{pausePrinter:1})">Pausar</button> ')
      +'<button class="btn btn-sm" onclick="sendCfg(\''+esc(p.name)+'\',{resumePrinter:1})">Retomar</button> '
      +'<button class="btn btn-sm" onclick="showConfig(\''+esc(p.name)+'\')">Config</button> '
      +'<button class="btn btn-sm" onclick="showRename(\''+esc(p.name)+'\')">Renomear</button> '
      +(ip?'<button class="btn btn-sm" onclick="showWeb(\''+esc(ip)+'\')">Painel web</button> ':'')
      +'<button class="btn btn-sm btn-danger" onclick="showDel(\''+esc(p.name)+'\')">Excluir</button>'
      +'</td></tr>';
  });
  h+='</tbody></table>';
  $('printerList').innerHTML=h;
  var sel=$('jobsPrinter');
  var cur=sel.value;
  sel.innerHTML='<option value="">— Todas as impressoras —</option>';
  list.forEach(function(p){var o=document.createElement('option');o.value=p.name;o.textContent=p.name;sel.appendChild(o);});
  sel.value=cur;
}
