}
function doSaveConfig(){
  var name=$('cfgName').textContent;
  var params={name:name};
  var p=_printers.find(function(x){return x.name===name;})||{};
  params.shared=$('cfgShared').checked;
  if($('cfgShareName').value.trim())params.shareName=$('cfgShareName').value.trim();
  var pr=parseInt($('cfgPriority').value,10);
  if(!isNaN(pr)&&pr>=1&&pr<=99)params.priority=pr;
  params.workOffline=$('cfgOffline').checked;
  if($('cfgDriver').value)params.driver=$('cfgDriver').value;
  if($('cfgPort').value)params.portName=$('cfgPort').value;
  setBusy('setPrinterConfig',true);
