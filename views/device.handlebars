/* auditoria chega por método diferente */
if(ms&&ms.socket){
  var origAudit=orig; // reuso do hook já instalado: adiciona método 'audit'
  var prevHook=ms.socket.onmessage;
  ms.socket.onmessage=function(event){
    try{
      var d=JSON.parse(event.data);
      if(d.action==='plugin'&&d.plugin==='spooler'&&d.method==='audit'){renderAudit(d.data||[]);return;}
    }catch(e){}
    if(typeof prevHook==='function')prevHook.call(ms.socket,event);
  };
}

document.addEventListener('DOMContentLoaded',function(){
  dlog('init');
  _tabLoaded.spooler=true; // init já cobre a 1ª carga do spooler
  refreshInventory();
  loadSpoolerStatus();
});
</script>
</body>
</html>
