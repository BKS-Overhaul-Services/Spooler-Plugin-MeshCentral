function showConfig(name){
  var p=_printers.find(function(x){return x.name===name;});
  if(!p)return;
  $('cfgName').textContent=name;
  $('cfgShared').checked=!!p.shared;
  $('cfgShareName').value=p.shareName||'';
  $('cfgPriority').value=p.priority||1;
  $('cfgOffline').checked=!!p.workOffline;
  if(!_drivers.length)send('listDrivers');
  if(!_ports.length)send('listPorts');
